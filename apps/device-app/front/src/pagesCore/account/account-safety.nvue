<template>
<scroll-view
  style="flex-direction: column; background-color: #f6f6f6; height: 100vh;"
  :scrollY="true"
  :showScrollbar="true"
>
  <view style="padding: 24rpx 32rpx 60rpx 32rpx; background-color: #f6f6f6;">
    <view style="background-color: #ffffff; border-radius: 16rpx; padding: 0 24rpx; margin-bottom: 24rpx;">
      <view
        style="display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 28rpx 0; border-bottom: 1rpx solid #f0f0f0; cursor: pointer;"
        @click="navigateToPage('/pagesCore/account/revise-pwd?userType=' + userType)"
      >
        <text style="font-size: 30rpx; color: #333333;" append="tree">
          {{ 3 == userType ? l('mine.setup.revise.terminal.pwd') : l('mine.setup.revise.Accounte.pwd') }}
        </text>
        <u-icon name="arrow-right" color="#cccccc" size="28rpx"></u-icon>
      </view>

      <view
        v-if="!isDeviceLogin"
        style="display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 28rpx 0; cursor: pointer;"
        @click="navigateToPage('/pagesCore/login/logout')"
      >
        <text style="font-size: 30rpx; color: #333333;" append="tree">
          {{ l('mine.setup.account.cancelled') }}
        </text>
        <u-icon name="arrow-right" color="#cccccc" size="28rpx"></u-icon>
      </view>
    </view>

    <view v-if="!isAuditMode" style="background-color: #ffffff; border-radius: 16rpx; padding: 24rpx;">
      <text style="font-size: 28rpx; font-weight: bold; color: #999999; margin-bottom: 20rpx; display: block;" append="tree">
        第三方账号绑定
      </text>

      <view style="display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0;">
        <view style="display: flex; flex-direction: row; align-items: center;">
          <u-icon :name="cdn + '/draw/qzwl-login-wechat.png'" size="48rpx"></u-icon>
          <text style="font-size: 30rpx; color: #333333; margin-left: 16rpx;" append="tree">
            微信账号
          </text>
        </view>
        <view style="display: flex; flex-direction: row; align-items: center;">
          <view v-if="wxInfo" style="display: flex; flex-direction: row; align-items: center;">
            <text style="font-size: 26rpx; color: #888888; margin-right: 8rpx;" append="tree">
              （已绑定）{{ wxInfo }}
            </text>
            <text style="font-size: 26rpx; color: #F56C6C; cursor: pointer;" append="tree" @click="unbind('wechat')">
              解绑
            </text>
          </view>
          <text v-else style="font-size: 26rpx; color: #F56C6C; cursor: pointer;" append="tree" @click="wxBind">
            未绑定
          </text>
        </view>
      </view>

      <view
        v-if="'ios' == sysInfo.platform"
        style="display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 20rpx 0;"
      >
        <view style="display: flex; flex-direction: row; align-items: center;">
          <u-icon :name="cdn + '/draw/qzwl-login-apple.png'" size="48rpx"></u-icon>
          <text style="font-size: 30rpx; color: #333333; margin-left: 16rpx;" append="tree">
            苹果账号
          </text>
        </view>
        <view style="display: flex; flex-direction: row; align-items: center;">
          <view v-if="appleInfo" style="display: flex; flex-direction: row; align-items: center;">
            <text style="font-size: 26rpx; color: #888888; margin-right: 8rpx;" append="tree">
              （已绑定）{{ appleInfo }}
            </text>
            <text style="font-size: 26rpx; color: #F56C6C; cursor: pointer;" append="tree" @click="unbind('apple')">
              解绑
            </text>
          </view>
          <text v-else style="font-size: 26rpx; color: #F56C6C; cursor: pointer;" append="tree" @click="appleBind">
            未绑定
          </text>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
</template>

<script>
/*
 * 页面: pagesCore/account/account-safety
 * 反编译自 webpack 模块 719（nvue 编译空间）
 * async/await 还原: 4 个已转换
 * 已剥离 webpack 的 global 注入包装（保留了 1 个注入参数的绑定）
 */
import mod22 from '@/.unpacked/nvue/22.js';
import mod23 from '@/.unpacked/nvue/23.js';
import mod5 from '@/.unpacked/nvue/5.js';
import * as mod25 from 'vuex';
import mod15 from '../../common/config.nvue.js';
import * as mod166 from '../../common/utils.nvue.js';
"use strict";
var e = require("@/.unpacked/nvue/17.js").default;
var m = getApp().globalData, c = {
  data: function () {
    return {
      cdn: mod15.cdn,
      info: null,
      wxInfo: "",
      appleInfo: ""
    };
  },
  computed: {
    ...mod25.mapGetters(["userType", "sysInfo", "isAuditMode"]),
    ...mod25.mapGetters("user", ["isDeviceLogin"]),
  },
  onLoad: function () {
    this.getMoreAccountInfo();
  },
  methods: {
    ...mod25.mapActions("account", ["GetUserAccountOauth", "BindWechatAccount", "BindAppleAccount", "UnbindAccount"]),
    l: function (e) {
      return m.$t(e);
    },
    /**
     * 第三方绑定信息（契约 2.3 oauth-accounts）只对 account 身份开放，
     * 设备身份调用返回 21010（见 0.4 的"前端身份能力边界"表）。
     * 这个页面本身设备身份可以进——它还承载"修改设备密码"，但这一段要跳过，
     * 否则一进页面就弹一个 21010。
     */
    getMoreAccountInfo: function () {
      var t = this;
      if (this.isDeviceLogin) return;
      return (async function () {
        var a = await t.GetUserAccountOauth();
        if (!a.succeeded) return;
        t.info = a.data;
        t.wxInfo = a.data.wechatUnionid ? a.data.wechatNickname : "";
        t.appleInfo = a.data.appleOpenid ? a.data.appleNickname : "";
      })();
    },
    wxBind: function () {
      var t, n = this;
      plus.runtime.isApplicationExist({
        pname: "com.tencent.mm",
        action: "weixin://"
      }) ? uni.login({
        provider: "weixin",
        onlyAuthorize: true,
        success: (t = async function (a) {
          e("log", a.code, "loginRes.code", " at pagesCore/account/account-safety.nvue:150");
          (await n.BindWechatAccount({
            code: a.code,
            type: 1
          })).succeeded && n.getMoreAccountInfo();
        }, function (e) {
          return t.apply(this, arguments);
        }),
        fail: function (e) {
          mod166.qzwlToast("\u7ed1\u5b9a\u5931\u8d25", "none");
        },
        complete: function (e) {}
      }) : mod166.qzwlToast("\u8bf7\u5148\u5b89\u88c5\u5fae\u4fe1");
    },
    appleBind: function () {
      var e = this;
      uni.login({
        provider: "apple",
        success: function (t) {
          var n;
          uni.getUserInfo({
            provider: "apple",
            success: (n = async function (n) {
              (await e.BindAppleAccount({
                openId: n.userInfo.openId,
                authorizationCode: n.userInfo.authorizationCode,
                identityToken: n.userInfo.identityToken
              })).succeeded && e.getMoreAccountInfo();
            }, function (e) {
              return n.apply(this, arguments);
            })
          });
        },
        fails: function (e) {
          mod166.qzwlToast("\u7ed1\u5b9a\u5931\u8d25", "none");
        }
      });
    },
    navigateToPage: function (e) {
      uni.navigateTo({
        url: e
      });
    },
    unbind: function (e) {
      var t = this, n = (function () {
        var n = async function () {
          (await t.UnbindAccount({
            mode: e
          })).succeeded && (t.getMoreAccountInfo(), mod166.qzwlToast("\u89e3\u7ed1\u6210\u529f", "none"));
        };
        return function () {
          return n.apply(this, arguments);
        };
      })();
      uni.showModal({
        title: "\u662f\u5426\u786e\u5b9a\u89e3\u7ed1",
        cancelText: "\u53d6\u6d88",
        confirmText: "\u786e\u5b9a",
        success: function (e) {
          e.cancel || n();
        }
      });
    }
  }
};
export default c;

</script>

