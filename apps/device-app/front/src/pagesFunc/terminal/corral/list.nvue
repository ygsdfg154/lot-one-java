/* #ifdef APP-PLUS */
.list-icon {
  width: 40rpx;
  height: 40rpx;
  border-width: 2rpx;
  border-style: solid;
  border-color: #909399;
  border-radius: 50;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
}
/* #endif */
/* #ifdef H5 */
.list-icon {
  width: 5.3333vw;
  height: 5.3333vw;
  border-width: 0.2667vw;
  border-style: solid;
  border-color: #909399;
  border-radius: 50;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
}
/* #endif */
