          for (; ; ) switch (e.prev = e.next) {
            case 0:
              if (t.reportType) {
                e.next = 9;
                break;
              }
              if ((t.longitude = t.reportInfo.startLon, t.latitude = t.reportInfo.startLat, t.drawStayMarkers(), t.reportInfo.address)) {
                e.next = 9;
