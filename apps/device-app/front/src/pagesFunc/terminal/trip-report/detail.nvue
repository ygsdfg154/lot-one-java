        latitude: this.reportInfo.startLat,
        width: 35,
        height: 35,
        anchor: {
          x: .5,
          y: .5
        },
        iconPath: ("").concat(mod15.cdn, "/ikon/qzwl-locus-stay.png ")
      }), this.markers = t);
    },
    drawLocusMarkers: function () {
      var t = [];
      this.reportInfo && (t.push({
