  border-radius: 16rpx;
}

.mode-item-text {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding-top: 28rpx;
  padding-right: 16rpx;
  padding-bottom: 30rpx;
  padding-left: 16rpx;
}

.time {
  margin-top: 16rpx;
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  align-items: center;
}

.time-title {
  font-size: 28rpx;
  color: #999999;
  margin-right: 16rpx;
}

.time-input {
  padding-top: 10rpx;
  padding-right: 20rpx;
  padding-bottom: 10rpx;
  padding-left: 20rpx;
  border-radius: 8rpx;
  background-color: #f2faff;
  font-size: 28rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.time-input-text {
  color: #333333;
  margin-right: 16rpx;
  font-size: 28rpx;
}
/* #endif */
/* #ifdef H5 */
.mode-item {
  background-color: #f3f9ff;
  border-radius: 3.2vw;
  padding-top: 4.2667vw;
  padding-right: 2.1333vw;
  padding-bottom: 2.1333vw;
  padding-left: 2.1333vw;
  margin-top: 3.2vw;
}

.mode-item-icon {
  width: 4.2667vw;
  height: 4.2667vw;
  border-width: 0.2667vw;
  border-style: solid;
  border-color: #cccccc;
  border-radius: 2.1333vw;
}

.mode-item-text {
  background-color: #ffffff;
  border-radius: 2.1333vw;
  padding-top: 3.7333vw;
  padding-right: 2.1333vw;
  padding-bottom: 4vw;
  padding-left: 2.1333vw;
}

.time {
  margin-top: 2.1333vw;
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  align-items: center;
}

.time-title {
  font-size: 3.7333vw;
  color: #999999;
  margin-right: 2.1333vw;
}

.time-input {
  padding-top: 1.3333vw;
  padding-right: 2.6667vw;
  padding-bottom: 1.3333vw;
  padding-left: 2.6667vw;
  border-radius: 1.0667vw;
  background-color: #f2faff;
  font-size: 3.7333vw;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.time-input-text {
  color: #333333;
  margin-right: 2.1333vw;
  font-size: 3.7333vw;
}
