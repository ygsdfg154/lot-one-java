/* #ifdef APP-PLUS */
.page {
  background-color: #f6f6f6;
}

.wechatTop {
  background-color: #ffffff;
  padding-top: 80rpx;
  padding-bottom: 50rpx;
}

.wechatTop-logoImg {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
}

.content {
  background-color: #ffffff;
  padding-top: 80rpx;
  padding-bottom: 50rpx;
  margin-top: 20rpx;
}

.content-logoImg {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
}
/* #endif */
/* #ifdef H5 */
.page {
  background-color: #f6f6f6;
}

.wechatTop {
  background-color: #ffffff;
  padding-top: 10.6667vw;
  padding-bottom: 6.6667vw;
}

.wechatTop-logoImg {
  width: 14.9333vw;
  height: 14.9333vw;
  border-radius: 2.1333vw;
}

.content {
  background-color: #ffffff;
  padding-top: 10.6667vw;
  padding-bottom: 6.6667vw;
  margin-top: 2.6667vw;
}

.content-logoImg {
  width: 14.9333vw;
  height: 14.9333vw;
  border-radius: 2.1333vw;
}
/* #endif */
</style>
