    default: m
  };
}
"use strict";
var s = (a(require("../../../common/config.nvue.js")), require("vuex"));
var _ = getApp().globalData, m = {
  data: function () {
    return {
      alarmTelList: [],
      // 剩余次数来自 VIP 配额（7.3 items[].remainingQuota），不在告警设置里；
      // 订阅包没有配额概念，此时为 null，页面显示"不限量"
      telRemain: "",
      quotaUnit: ""
    };
  },
  onShow: function () {
    this.fetchData();
  },
  computed: {
    ...s.mapGetters(["isAuditMode", "selectedTerminal", "access_token"]),
    telSum: function () {
      var e = 0;
      return !(this.alarmTelList.reduce(function (t, n) {
        return e = n ? ++e : e;
      }, 0) >= 1);
    }
  },
  methods: {
    ...s.mapActions("alarm", ["GetAlarmSettings", "SetNotifyPhones", "GetAlarmQuota"]),
    l: function (e) {
      return _.$t(e);
    },
    /**
     * 电话告警接收号码（8.6.2b telPhones）。这份名单与另一个渠道的名单**互相独立**，
     * 保存时 store 会把对方那份原样带回，不会互相清空。
     */
    fetchData: function () {
      var self = this;
      return (async function () {
        var res = await self.GetAlarmSettings({
          deviceId: self.selectedTerminal && self.selectedTerminal.id
        });
        if (res.succeeded && res.data) {
          // 补齐到 6 个空位，模板按下标绑定输入框
          var phones = (res.data.telPhones || []).slice(0, 6);
          while (phones.length < 6) phones.push("");
          self.alarmTelList = phones;
        }
        var q = await self.GetAlarmQuota({
          deviceId: self.selectedTerminal && self.selectedTerminal.id
        });
        if (q && q.quota) {
          self.telRemain = q.quota.remaining == null ? "不限量" : String(q.quota.remaining);
          self.quotaUnit = q.quota.unitName || "";
        } else {
          self.telRemain = "-";
        }
      })();
    },
    saveAlarmTel: function () {
      var e = this;
      return mod23(mod22.mark(function t() {
        var n;
        return mod22.wrap(function (t) {
          for (; ; ) switch (t.prev = t.next) {
            case 0:
              if (!e.telSum) {
                t.next = 2;
                break;
              }
              return t.abrupt("return", mod166.qzwlToast(_.$t("common.save.one.tel"), "none"));
            case 2:
              if ((n = e.alarmTelList.filter(function (e) {
                return e;
              }), n.every(function (e) {
                return uni.$u.test.mobile(e);
              }))) {
                t.next = 6;
                break;
              }
              return t.abrupt("return", mod166.qzwlToast(_.$t("common.please.valid.mobile.tel"), "none"));
            case 6:
              if (!(Array.from(new Set(n)).length < n.length)) {
                t.next = 9;
                break;
              }
              return t.abrupt("return", mod166.qzwlToast(_.$t("common.please.equal.tel"), "none"));
            case 9:
              return (t.next = 11, e.SetNotifyPhones({
                deviceId: e.selectedTerminal && e.selectedTerminal.id,
                channel: "tel",
                phones: e.alarmTelList
              }));
            case 11:
              if (!t.sent.succeeded) {
                t.next = 16;
                break;
              }
              return (t.next = 15, e.fetchData(true));
            case 15:
              mod166.qzwlToast(_.$t("common.save.success"), "none");
            case 16:
            case "end":
              return t.stop();
          }
        }, t);
      }))();
    },
    gotoTopup: function () {
      mod166.qzGotoWx({
        id: this.selectedTerminal.id,
        url: "/pagesPay/value-added/index?type=3&alarm=1",
        access_token: this.access_token
      });
    }
  }
};
export default m;

