<template>
<scroll-view
  style="flex-direction: column"
  :scrollY="true"
  :showScrollbar="true"
  :enableBackToTop="true"
  bubble="true"
>
  <view class="flex-1 bg-white b-top">
    <view class="p-lg">
      <view class="flex-col">
        <text class="m-b text-lg text-bold" append="tree">
          {{ l('tel-pay.wechat-mp') }}
        </text>
        <text class="text-md text-gray" append="tree">
          {{ l('tel-pay.wechat-mp.attention') }}
        </text>
      </view>
      <view class="page">
        <view class="flex-col justify-center">
          <image
            class="br-md"
            :style="{ width: '150rpx', height: '150rpx' }"
            :src="cdn + '/draw/qzwl-logo.png'"
           />
          <text class="m-l text-bold text-md" append="tree">
            {{ l('tel-pay.wx-name') }}
          </text>
        </view>
        <view class="page-main p-lg m-t-lg flex-col">
          <text class="text-bold text-md" append="tree">
            {{ l('tel-pay.wx-mp.public') }}？
          </text>
          <text class="text-gray m-t-lg text-md" append="tree">
            {{ l('tel-pay.wx-mp.method1') }}
          </text>
          <text class="text-link text-md" append="tree" @click="copy(l('tel-pay.wx-name'))">
            {{ l('tel-pay.wx-mp.method1-text') }}
          </text>
          <text class="text-gray m-t-lg text-md" append="tree">
            {{ l('tel-pay.wx-mp.method2') }}
          </text>
          <text class="text-link text-md" append="tree" @click="saveQRCode">
            {{ l('tel-pay.wx-mp.method2-text') }}
          </text>
          <image
            class="m-t-sm"
            :style="{ width: '200rpx', height: '200rpx' }"
            :src="cdn + '/draw/qzwl-qrCode.png'"
            @click="preview"
           />
        </view>
        <view class="bottom-bar">
          <u-button type="primary" :text="l('tel-pay.wx-mp.success')" @click="wechatChange"></u-button>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
</template>

<script>
/*
 * 页面: pagesFunc/terminal/alerts-set/wx-mp
 * 反编译自 webpack 模块 704（nvue 编译空间）
 * async/await 还原: 0 个已转换, 2 个含条件跳转/try-catch 保持状态机原样
 * 已剥离 webpack 的 global 注入包装（保留了 1 个注入参数的绑定）
 * 变量 s 在内层被重新声明，保留短名以维持遮蔽语义
 */
import mod22 from '@/.unpacked/nvue/22.js'
import s from '@/.unpacked/nvue/23.js'
import mod5 from '@/.unpacked/nvue/5.js'
import mod15 from '../../../common/config.nvue.js'
import * as mod25 from 'vuex'
import * as mod166 from '../../../common/utils.nvue.js'

"use strict";
var e = require("@/.unpacked/nvue/17.js").default;
var r;
var c = getApp().globalData, h = {
  data: function () {
    return {
      cdn: mod15.cdn,
      wechatId: 0,
      code: ""
    };
  },
  onLoad: function (e) {
    this.wechatId = e.wechatId;
  },
  onHide: function () {
    (clearInterval(r), this.setWechatUserInfo(null));
  },
  computed: {
    ...mod25.mapState("wechat", ["wechatUserInfo"])
  },
  methods: {
    ...mod25.mapActions("wechat", ["GetWxSign"]),
    ...mod25.mapActions("account", ["BindWechatAccount"]),
    ...mod25.mapMutations("wechat", ["setWechatUserInfo"]),
    l: function (e) {
      return c.$t(e);
    },
    copy: function (e) {
      uni.setClipboardData({
        data: e,
        showToast: false,
        success: function () {
          mod166.qzwlToast("\u5185\u5bb9\u5df2\u590d\u5236");
        }
      });
    },
    saveQRCode: function () {
      uni.saveImageToPhotosAlbum({
        filePath: this.cdn + "/draw/qzwl-qrCode.png",
        success: function (e) {
          mod166.qzwlToast(c.$t("tel-pay.wx-mp.save-qr"), "none");
        }
      });
    },
    preview: function () {
      uni.previewImage({
        current: this.cdn + "/draw/qzwl-qrCode.png",
        urls: [this.cdn + "/draw/qzwl-qrCode.png"],
        longPressActions: {
          itemList: [c.$t("tel-pay.wx-save-img")],
          success: function (e) {
            uni.saveImageToPhotosAlbum({
              filePath: this.cdn + "/draw/qzwl-qrCode.png",
              success: function (e) {
                mod166.qzwlToast(c.$t("tel-pay.wx-mp.save-qr"), "none");
              },
              fail: function (e) {
                mod166.qzwlToast(c.$t("tel-pay.wx-save-qr-fail"), "none");
              }
            });
          },
          fail: function (t) {
            e("log", t.errMsg, " at pagesFunc/terminal/alerts-set/wx-mp.nvue:139");
          }
        }
      });
    },
    /**
     * 换绑/绑定微信 = 契约 2.1 `POST /auth/app/bind-wechat`（credential 是 wx.login 的 code）。
     * 原版先用 `/wx/get-wx-user-info` 换昵称头像再打 `set-wechat-alarm`，契约里绑定与
     * 推送开关是两件事：这里只做绑定，推送开关在告警设置页由用户自己开。
     * 21013：该微信已绑到别的账号——按后端文案提示，不要自行改写成"绑定失败"。
     */
    wechatChange: function () {
      var self = this;
      uni.login({
        provider: "weixin",
        onlyAuthorize: true,
        success: function (loginRes) {
          (async function () {
            var res = await self.BindWechatAccount({ credential: loginRes.code });
            if (res && res.msg) mod166.qzwlToast(res.msg, "none");
            if (res && res.succeeded) {
              r = setTimeout(function () {
                uni.navigateBack();
              }, 1500);
            }
          })();
        },
        fail: function () {
          mod166.qzwlToast(c.$t("alarm-setup.bindwx-faild"), "none");
        }
      });
    }
  }
};
export default h;

</script>

<style scoped>
/* #ifdef APP-PLUS */
.page {
  margin-top: 30rpx;
}

.page-main {
  border-width: 1rpx;
  border-style: solid;
  border-color: #dbdcdd;
  background-color: #f6f6f6;
}

.bottom-bar {
  position: fixed;
  bottom: 0rpx;
  left: 0rpx;
  width: 750rpx;
}
/* #endif */
/* #ifdef H5 */
.page {
  margin-top: 4vw;
}

.page-main {
  border-width: 0.1333vw;
  border-style: solid;
  border-color: #dbdcdd;
  background-color: #f6f6f6;
}

.bottom-bar {
  position: fixed;
  bottom: 0vw;
  left: 0vw;
  width: 100vw;
}
/* #endif */
</style>
