            </text>
            <text style="font-size: 24rpx; color: #888888; margin-top: 4rpx;" append="tree">
              {{ wirelessDeviceState ? l('self-test.power-state-capacity') : l('self-test.detection-battery-capacity') }}
            </text>
          </view>
