<template>
<scroll-view
  style="flex-direction: column"
  :scrollY="true"
  :showScrollbar="true"
  :enableBackToTop="true"
  bubble="true"
>
  <view class="flex-1 bg-white">
    <u-cell-group :customStyle="{ 'font-size': '32rpx' }">
      <u-cell
        v-if="terminalFuncShow(22)"
        class="flex-col justify-center"
        size="large"
        :isLink="true"
        :title="l('common.remote.onOff')"
        @click="setDirective(0, 'common.remote.onOff', 'common.remote.onOff.introduce', 'OffOn')"
      ></u-cell>
      <u-cell
        v-if="terminalFuncShow(28)"
        class="flex-col justify-center"
        size="large"
        :isLink="true"
        :title="l('remote-setup.immediately.locate')"
        @click="refreshLocate"
      ></u-cell>
      <u-cell
        v-if="terminalFuncShow(1)"
        class="flex-col justify-center"
        size="large"
        :isLink="true"
        :title="l('alarm.setup.g/r')"
        @click="setDirective(0, 'alarm.setup.garrison', 'remote-setup.garrison', 'Garrison')"
      ></u-cell>
      <u-cell
        v-if="terminalFuncShow(45)"
        class="flex-col justify-center"
        size="large"
        :isLink="true"
        :title="l('alarm.setup.dismantle')"
        @click="setDirective(0, 'alarm.setup.dismantle', 'remote-setup.dismantle', 'TamperAlarm')"
      ></u-cell>
      <u-cell
        v-if="terminalFuncShow(43)"
        class="flex-col justify-center"
        size="large"
        :isLink="true"
        :title="l('alarm.setup.vibration')"
        @click="setDirective(0, 'alarm.setup.vibration', 'remote-setup.vibration', 'Vibration')"
      ></u-cell>
      <u-cell
        v-if="terminalFuncShow(44)"
        class="flex-col justify-center"
        size="large"
        :isLink="true"
        :title="l('alarm.setup.speed')"
        @click="setDirective(3, 'alarm.setup.speed', 'remote-setup.speed', 'SpeedAlarm')"
      ></u-cell>
      <u-cell
        v-if="terminalFuncShow(55)"
        class="flex-col justify-center"
        size="large"
        :isLink="true"
        :title="l('alarm.setup.battery')"
        @click="setDirective(0, 'alarm.setup.battery', 'remote-setup.lowBattery', 'LowBatteryAlarm')"
      ></u-cell>
      <u-cell
        v-if="terminalFuncShow(60)"
        class="flex-col justify-center"
        size="large"
        :isLink="true"
        :title="l('alarm-setup.cut-power')"
        @click="setDirective(0, 'alarm-setup.cut-power', 'remote-setup.cutPower', 'CutPowerAlarm')"
      ></u-cell>
      <u-cell
        v-if="terminalFuncShow(46)"
        class="flex-col justify-center"
        size="large"
        :isLink="true"
        :title="l('alarm-setup.Voice')"
        @click="setDirective(0, 'alarm-setup.Voice', 'remote-setup.voice', 'VoiceAlarm')"
      ></u-cell>
      <u-cell
        v-if="terminalFuncShow(59)"
        class="flex-col justify-center"
        size="large"
        :isLink="true"
        :title="l('alarm.setup.sos-alarm')"
        @click="setDirective(0, 'alarm.setup.sos-alarm', 'remote-setup.sos', 'SosAlarm')"
      ></u-cell>
      <u-cell
        v-if="terminalFuncShow(35)"
        class="flex-col justify-center"
        size="large"
        :isLink="true"
        :title="l('remote-setup.white.tel')"
        @click="setDirective(2, 'remote-setup.white.tel', 'remote-setup.white.tel.describe', 'white')"
      ></u-cell>
      <u-cell
        v-if="terminalFuncShow(12)"
        class="flex-col justify-center"
        size="large"
        :isLink="true"
        :title="l('alarm-setup.buffer')"
        @click="setDirective(0, 'alarm-setup.buffer', 'alarm-setup.buffer-text', 'Buffer')"
      ></u-cell>
      <u-cell
        v-if="terminalFuncShow(31)"
        class="flex-col justify-center"
        size="large"
        :isLink="true"
        :title="l('remote-setup.custom.instruct')"
        @click="setDirective(1, 'remote-setup.custom.instruct', 'remote-setup.custom.instruct-describe', 'custom')"
      ></u-cell>
      <u-cell
        v-if="terminalFuncShow(29)"
        class="flex-col justify-center"
        size="large"
        :isLink="true"
        :title="l('remote-setup.terminal-restart')"
        @click="resetTerminal"
      ></u-cell>
      <!-- 契约用"定位模式档位"表达上报频率（8.4 / 9.4.1），不是原厂的自由秒数 -->
      <u-cell
        v-if="terminalFuncShow(10001)"
        class="flex-col justify-center"
        size="large"
        :isLink="true"
        title="定位模式"
        :value="posModeName"
        @click="setUploadTime"
      ></u-cell>
      <u-cell
        v-if="terminalFuncShow(42)"
        class="flex-col justify-center"
        size="large"
        :isLink="true"
        :title="l('remote-setup.factory-reset')"
        @click="factoryReset"
      ></u-cell>
    </u-cell-group>
    <u-picker
      style="position: absolute"
      :show="showUploadTime"
      keyName="label"
      :columns="posModeColumns"
      :closeOnClickOverlay="true"
      @confirm="timeConfirm"
      @cancel="showUploadTime = false"
    ></u-picker>
    <u-popup
      style="position: absolute"
      :show="funcPopupShow"
      round="15"
      :closeable="true"
      mode="bottom"
      :closeOnClickOverlay="true"
      @close="funcPopupShow = false"
    >
      <directivePopup
        v-if="funcPopupShow"
        :popupType="popupType"
        :directive="directive"
        :describe="describe"
        :param="param"
      ></directivePopup>
    </u-popup>
  </view>
</scroll-view>
