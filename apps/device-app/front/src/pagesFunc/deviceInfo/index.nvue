<script>
/*
 * 页面: pagesFunc/deviceInfo/index
 * 反编译自 webpack 模块 641（nvue 编译空间）
 * async/await 还原: 3 个已转换
 * 变量 i 在内层被重新声明，保留短名以维持遮蔽语义
 */
import mod22 from '@/.unpacked/nvue/22.js';
import i from '@/.unpacked/nvue/23.js';
import mod5 from '@/.unpacked/nvue/5.js';
import * as mod25 from 'vuex';
import * as mod166 from '../../common/utils.nvue.js';
import mod15 from '../../common/config.nvue.js';
"use strict";
var c = getApp().globalData, m = {
  data: function () {
    return {
      cdn: mod15.cdn,
      primaryColor: mod15.primaryColor,
      deviceName: "",
      currentDeviceName: "",
      terminalIconInfo: {
        id: 0,
        iconType: 0,
        code: "",
        iconName: ""
      },
      terminalIconShow: false,
      terminalNameShow: false,
      lbsStatus: false
    };
  },
  onShow: function () {
    this.fetchData();
  },
  computed: {
    ...mod25.mapGetters(["selectedTerminal", "appConfig", "terminalFuncs"]),
    ...mod25.mapState("device", ["deviceIcons"]),
    genAddress: function () {
      return (this.selectedTerminal ? this.selectedTerminal.TextLocation : this.l("common.get.locate")) || this.l("common.get.locate-fail");
    },
    terminalIcon: function () {
      return ("").concat(this.cdn, "/ikon/device/").concat(this.terminalIconInfo.code, "-1.png");
    },
    wireless: function () {
      return mod15.wirelessDevice.includes(this.selectedTerminal.terminalTypeDisplayName);
    }
  },
  methods: {
    ...mod25.mapActions("device", ["SetDeviceInfo", "GetDeviceInfo", "SetTerminalFilter"]),
    l: function (e) {
      return c.$t(e);
    },
    gotoPages: function (e) {
      uni.navigateTo({
        url: e
      });
    },
    bStateHangle: function (e, t) {
      return mod166.batteryStateHangle(e, t);
    },
    fetchData: function () {
      var e = this;
      return (async function () {
        var n, r, i;
        (n = await e.GetDeviceInfo({
          deviceID: e.selectedTerminal.id
        })).succeeded && (e.deviceName = e.currentDeviceName = n.data.terminalName, e.lbsStatus = 1 == n.data.lbs, r = e.deviceIcons.find(function (e) {
          return e.id == n.data.iconType;
        }), i = r ? {
          id: r.id,
          iconType: r.id,
          iconName: r.name,
          code: r.code
        } : {
          id: 1,
          iconType: 1,
          iconName: "\u9ed8\u8ba4",
          code: "default"
        }, e.terminalIconInfo = i);
      })();
    },
    copy: function (e) {
      uni.setClipboardData({
        data: e,
        showToast: false,
        success: function () {
          mod166.qzwlToast("\u5185\u5bb9\u5df2\u590d\u5236");
        }
      });
    },
    setTerminalName: function () {
      (this.terminalNameShow = false, this.putDeviceInfo({
        terminalId: this.selectedTerminal.id,
        deviceName: this.currentDeviceName ? this.currentDeviceName.trim() : this.currentDeviceName
      }));
    },
    terminalNameClose: function () {
      (this.terminalNameShow = false, this.fetchData());
    },
    putDeviceInfo: function (e) {
      var t = this;
      return (async function () {
        (await t.SetDeviceInfo(e)).succeeded && (mod166.qzwlToast(t.l("common.save.success"), "none"), t.fetchData());
      })();
    },
    lbsStateChange: function (e) {
      var t = this;
      return (async function () {
        var r;
        ((r = await t.SetTerminalFilter({
          terminalId: t.selectedTerminal.id,
          Lbs: e ? 1 : 2
        })).succeeded && mod166.qzwlToast(e ? t.l("info.no.filter.lbs") : t.l("info.ilter.lbs"), "none"), r.succeeded || (t.lbsStatus = !e));
      })();
    }
  }
};
export default m;

</script>

