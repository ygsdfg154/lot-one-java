.main {
  position: fixed;
  width: 600rpx;
  left: 75rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
}
/* #endif */
/* #ifdef H5 */
.main {
  position: fixed;
  width: 80vw;
  left: 10vw;
  background-color: #ffffff;
  border-radius: 2.1333vw;
}
/* #endif */
