          秒速定位 点击开启
        </text>
      </view>
      <view class="infobox" style="width: calc(100% - 32rpx); margin-left: 16rpx; margin-right: 16rpx; background-color: #fff; height: auto !important; display: flex; flex-direction: column; justify-content: flex-start; box-sizing: border-box; border-top-left-radius: 24rpx; border-top-right-radius: 24rpx;">
        <view class="flex-row items-center justify-between" style="height: 48rpx; display: flex; flex-direction: row; align-items: center; justify-content: space-between;">
