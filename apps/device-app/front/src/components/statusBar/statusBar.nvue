<template>
<view class="uni-status-bar" :style="{ height: $data.statusBarHeight }">
  <slot></slot>
</view>
</template>

<script>
/*
 * 组件: statusBar
 * 反编译自 webpack 模块 333（nvue 编译空间）
 */
"use strict";
var a = {
  name: "UniStatusBar",
  data: function () {
    return {
      statusBarHeight: 20
    };
  },
  mounted: function () {
    this.statusBarHeight = uni.getSystemInfoSync().statusBarHeight + "px";
  }
};
export default a;

</script>

<style scoped>
.uni-status-bar {
  height: 20;
}
</style>
