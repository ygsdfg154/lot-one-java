        <text class="share-input-text" append="tree">
          {{ shareTime }}
        </text>
        <u-icon class="share-input-icon" name="arrow-down"></u-icon>
      </view>
    </view>
    <view class="bottom-bar">
      <u-button type="primary" :text="l('common.share.but')" @click="confirmShare"></u-button>
    </view>
  </u-popup>
  <u-popup
    :show="isToShare"
    round="15"
    mode="bottom"
    :closeOnClickOverlay="true"
    @close="isToShare = false"
  >
    <view class="toShare">
      <view class="flex-row justify-center">
        <text class="toShareTitle" append="tree">
          {{ l('audio.share-record') }}
        </text>
      </view>
      <view class="toShareMain">
