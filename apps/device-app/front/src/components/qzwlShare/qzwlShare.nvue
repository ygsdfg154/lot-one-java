          <text class="text-sm m-t-sm" append="tree">
            {{ l('common.wx') }}
          </text>
        </view>
        <view class="toShareCopy" @click="shareCopy">
          <u-icon :name="cdn + '/draw/qzwl-share-cp.png'" size="96rpx"></u-icon>
          <text class="text-sm m-t-sm" append="tree">
            {{ l('common.copy.link') }}
          </text>
        </view>
      </view>
    </view>
  </u-popup>
  <u-picker
    :show="selectTime"
    :columns="columns"
    :closeOnClickOverlay="true"
    :defaultIndex="defaultIndex"
    keyName="label"
    :cancelText="l('common.cancel')"
    :confirmText="l('common.confirm')"
    @cancel="selectTime = false"
    @close="selectTime = false"
    @confirm="confirmTime"
  ></u-picker>
</view>
</template>

<script>
/*
 * 组件: qzwlShare
 * 反编译自 webpack 模块 373（nvue 编译空间）
 * async/await 还原: 0 个已转换, 1 个含条件跳转/try-catch 保持状态机原样
 * 已剥离 webpack 的 global 注入包装（保留了 1 个注入参数的绑定）
 */
import mod22 from '@/.unpacked/nvue/22.js'
import mod23 from '@/.unpacked/nvue/23.js'
import mod5 from '@/.unpacked/nvue/5.js'
import * as mod25 from 'vuex'
import mod15 from '../../common/config.nvue.js'
import * as mod166 from '../../common/utils.nvue.js'

"use strict";
var e = require("@/.unpacked/nvue/17.js").default;
var _ = getApp().globalData, m = {
  data: function () {
    return {
      cdn: mod15.cdn,
      shareLocationShow: false,
      selectTime: false,
      shareTime: _.$t("common.0.5-day"),
      isToShare: false,
      defaultIndex: [0],
      selectedTime: 720,
      code: "",
      wxBrowser: false
    };
  },
  computed: {
    ...mod25.mapGetters(["selectedTerminal", "userId"]),
    columns: function () {
      return [[{
        label: this.l("common.0.5-day"),
        time: 720
      }, {
        label: this.l("common.1-day"),
        time: 1440
      }, {
        label: this.l("common.3-day"),
        time: 4320
      }, {
        label: this.l("common.7-day"),
        time: 10080
      }]];
    }
  },
  methods: {
    ...mod25.mapActions("device", ["AddSharePosition"]),
    l: function (e) {
      return _.$t(e);
    },
    confirmShare: function () {
      var t = this;
      return mod23(mod22.mark(function n() {
        var a;
        return mod22.wrap(function (n) {
          for (; ; ) switch (n.prev = n.next) {
            case 0:
              if (t.selectedTerminal.lon || t.selectedTerminal.lat) {
                n.next = 2;
                break;
              }
              return n.abrupt("return", mod166.qzwlToast("\u5f53\u524d\u8bbe\u5907\u65e0\u5b9a\u4f4d\u4fe1\u606f", "none"));
            case 2:
              return (n.next = 4, t.AddSharePosition({
                deviceId: t.selectedTerminal.id,
                userId: t.userId,
                duration: t.selectedTime
              }));
            case 4:
              (a = n.sent, e("log", a.data.code, "result", " at components/qzwlShare.nvue:124"), a.succeeded && a.data.code && (t.code = a.data.code, t.defaultIndex = [0], t.shareTime = _.$t("common.0.5-day"), t.selectedTime = 720, t.isToShare = true));
            case 7:
            case "end":
              return n.stop();
          }
        }, n);
      }))();
    },
    shareWx: function () {
      var t = ("").concat(mod15.sharePositionUrl, "?code=").concat(this.code);
      (e("log", t, "url", " at components/qzwlShare.nvue:163"), uni.share({
        provider: "weixin",
        type: 3,
        title: _.$t("common.share.locate"),
        scene: "WXSceneSession",
        mediaUrl: t,
        imageUrl: this.cdn + "/draw/qzwl-logo-108.png"
      }), this.isToShare = false);
    },
    shareCopy: function () {
      var e = ("").concat(mod15.sharePositionUrl, "?code=").concat(this.code);
      (uni.setClipboardData({
        data: e,
        showToast: false,
        success: function () {
          mod166.qzwlToast(_.$t("common.copy.success"), "none");
        }
      }), this.isToShare = false);
    },
    confirmTime: function (e) {
      (this.selectTime = false, this.shareTime = e.value[0].label, this.selectedTime = e.value[0].time);
    }
  }
};
export default m;

</script>

