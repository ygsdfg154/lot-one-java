<template>
<view class="u-gap" :style="[$data.gapStyle]"></view>
</template>

<script>
/*
 * 组件: uGap
 * 反编译自 webpack 模块 610（nvue 编译空间）
 */
import mod955 from '@/.unpacked/nvue/955.js'

"use strict";
var i = {
  name: "u-gap",
  mixins: [uni.$u.mpMixin, uni.$u.mixin, mod955],
  computed: {
    gapStyle: function () {
      var e = {
        backgroundColor: this.bgColor,
        height: uni.$u.addUnit(this.height),
        marginTop: uni.$u.addUnit(this.marginTop),
        marginBottom: uni.$u.addUnit(this.marginBottom)
      };
      return uni.$u.deepMerge(e, uni.$u.addStyle(this.customStyle));
    }
  }
};
export default i;

</script>
