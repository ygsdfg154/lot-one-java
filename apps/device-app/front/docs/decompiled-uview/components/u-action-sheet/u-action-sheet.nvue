  font-size: 16;
  color: #303133;
  font-weight: bold;
  text-align: center;
}

.u-action-sheet__header__icon-wrap {
  position: absolute;
  right: 15;
  top: 15;
}

.u-action-sheet__description {
  font-size: 13;
  color: #909193;
  margin-top: 18;
  margin-right: 15;
  margin-bottom: 18;
  margin-left: 15;
  text-align: center;
}

.u-action-sheet__item-wrap__item {
  padding-top: 15;
  padding-right: 15;
  padding-bottom: 15;
  padding-left: 15;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.u-action-sheet__item-wrap__item__name {
  font-size: 16;
  color: #303133;
  text-align: center;
}

.u-action-sheet__item-wrap__item__subname {
  font-size: 13;
  color: #c0c4cc;
  margin-top: 10;
  text-align: center;
}

.u-action-sheet__cancel-text {
  font-size: 16;
  color: #606266;
  text-align: center;
  padding-top: 16;
