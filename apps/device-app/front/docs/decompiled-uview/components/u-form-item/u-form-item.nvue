<template>
<view class="u-form-item">
  <view
    class="u-form-item__body"
    :style="[$u.addStyle(customStyle), { flexDirection: 'left' === (labelPosition || parentData.labelPosition) ? 'row' : 'column' }]"
    @click="clickHandler"
  >
    <slot name="label">
      <view
        v-if="required || leftIcon || label"
        class="u-form-item__body__left"
        :style="{ width: $u.addUnit(labelWidth || parentData.labelWidth), marginBottom: 'left' === parentData.labelPosition ? 0 : '5px' }"
      >
