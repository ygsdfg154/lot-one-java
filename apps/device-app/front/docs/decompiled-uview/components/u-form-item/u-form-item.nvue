          <text v-if="required" class="u-form-item__body__left__content__required" append="tree">
            *
          </text>
          <view v-if="leftIcon" class="u-form-item__body__left__content__icon">
            <u-icon :name="leftIcon" :customStyle="leftIconStyle"></u-icon>
          </view>
          <text
            class="u-form-item__body__left__content__label"
            :style="[parentData.labelStyle, { justifyContent: 'left' === parentData.labelAlign ? 'flex-start' : 'center' === parentData.labelAlign ? 'center' : 'flex-end' }]"
            append="tree"
          >
            {{ label }}
          </text>
        </view>
      </view>
    </slot>
    <view class="u-form-item__body__right">
      <view class="u-form-item__body__right__content">
        <view class="u-form-item__body__right__content__slot">
          <slot></slot>
